<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Assembly filters: test projects and EF migrations. Unit and integration runs share
               this file. The Coveralls report drops the integration-tested provider adapters
               and hosts afterwards (reportgenerator -assemblyfilters in ci.yml); SonarCloud keeps them. -->
          <Exclude>[*.Tests]*,[*]*.Migrations.*,[Endatix.IntegrationTests]*,[Endatix.IntegrationTests.Shared]*</Exclude>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <!-- File filters: tests, build output (source generators), EF migrations, embedded SQL script helpers -->
          <ExcludeByFile>**/tests/**/*.cs,**/obj/**/*.cs,**/Migrations/**/*.cs,**/Scripts/**/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
