<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Temporary, for the spec-first spike only. Endatix.Jobs.Api.Server.Contract is generated
         in the private endatix/api-contracts repo, whose GitHub Packages feed cannot be read
         without access to that repo — which would make this public repository unbuildable for
         anyone outside the organisation. If the approach is adopted, the package publishes to
         nuget.org like Endatix.Api.Host does, and both this source and local-packages/ go away. -->
    <add key="local-spike" value="local-packages" />
  </packageSources>
</configuration>
