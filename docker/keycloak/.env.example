# Copy to .env and set every value, or run ./generate-dev-env.sh to create .env with random values.
# .env is ignored by git. Keycloak reads these only on the first realm import.

# Admin console password for user "admin"
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Password for every user in the endatix realm
KC_DEV_USER_PASSWORD=

# Secret of the endatix-hub client. Use the same value in the API ClientSecret and Hub AUTH_KEYCLOAK_CLIENT_SECRET.
KC_HUB_CLIENT_SECRET=
