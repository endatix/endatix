{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=endatix_db;Username=postgres;Password=CHANGE_ME",
    "DefaultConnection_DbProvider": "postgresql"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "System": "Warning",
      "Endatix": "Debug"
    },
    "Console": {
      "FormatterName": "simple"
    }
  },
  "Endatix": {
    "Hub": {
      "HubBaseUrl": "http://localhost:3000"
    },
    "Hosting": {},
    "Auth": {
      "Providers": {
        "EndatixJwt": {
          "SigningKey": "TEST:Endatix.LocalDev.JwtSigningKey.NotForProduction.UseUserSecrets",
          "AccessExpiryInMinutes": 90,
          "RefreshExpiryInDays": 7,
          "Issuer": "endatix-api",
          "ReBacIssuer": "edx_res_auth",
          "Audiences": ["endatix-hub", "endatix-client"]
        }
      }
    },
    "Data": {
      "EnableAutoMigrations": true,
      "SeedSampleData": true,
      "SeedSampleForms": true,
      "InitialUser": {
        "Email": "admin@endatix.com",
        "Password": "P@ssw0rd"
      }
    },
    "EmailVerification": {
      "TokenExpiryInHours": 24
    },
    "Cors": {
      "DefaultPolicyName": "DevCorsPolicy",
      "CorsPolicies": [
        {
          "PolicyName": "DevCorsPolicy",
          "AllowedOrigins": ["*"],
          "AllowedMethods": ["*"],
          "AllowedHeaders": ["*"],
          "AllowCredentials": false
        }
      ]
    },
    "Outbox": {
      "RunInProcess": true,
      "PollIntervalSeconds": 5,
      "BatchSize": 50,
      "LeaseSeconds": 60,
      "MaxAttempts": 8,
      "BackoffBaseSeconds": 5,
      "BackoffCapSeconds": 300
    },
    "WebHooks": {
      "Tenants": {
        "1": {
          "Events": {
            "FormCreated": {
              "IsEnabled": false,
              "WebHookEndpoints": [
                {
                  "Url": "",
                  "Authentication": {
                    "Type": "ApiKey",
                    "ApiKeyHeader": "",
                    "ApiKey": ""
                  }
                }
              ]
            },
            "FormUpdated": {
              "IsEnabled": false,
              "WebHookEndpoints": [
                {
                  "Url": "",
                  "Authentication": {
                    "Type": "ApiKey",
                    "ApiKeyHeader": "",
                    "ApiKey": ""
                  }
                }
              ]
            },
            "FormEnabledStateChanged": {
              "IsEnabled": false,
              "WebHookEndpoints": [
                {
                  "Url": "",
                  "Authentication": {
                    "Type": "ApiKey",
                    "ApiKeyHeader": "",
                    "ApiKey": ""
                  }
                }
              ]
            },
            "FormDeleted": {
              "IsEnabled": false,
              "WebHookEndpoints": [
                {
                  "Url": "",
                  "Authentication": {
                    "Type": "ApiKey",
                    "ApiKeyHeader": "",
                    "ApiKey": ""
                  }
                }
              ]
            },
            "SubmissionCompleted": {
              "IsEnabled": false,
              "WebHookEndpoints": [
                {
                  "Url": "",
                  "Authentication": {
                    "Type": "ApiKey",
                    "ApiKeyHeader": "",
                    "ApiKey": ""
                  }
                }
              ]
            }
          }
        }
      }
    },
    "Submissions": {
      "TokenExpiryInHours": 24,
      "AccessTokenSigningKey": "wK9mP#xL2vN$8qR5tY!jH3zF@nC7bV*eU4sA6dG~iO1pW0hX-fM+gQ="
    },
    "FeatureFlags": {
      "ExperimentalFeatures": "true"
    },
    "Integrations": {
      "Email": {
        "SendGridSettings": {
          "ApiKey": "{{SENDGRID_API_KEY}}"
        },
        "SmtpSettings": {
          "Host": "localhost",
          "Port": 587,
          "EnableSsl": true,
          "DefaultFromAddress": "noreply@endatix.com",
          "DefaultFromName": "Endatix"
        }
      }
