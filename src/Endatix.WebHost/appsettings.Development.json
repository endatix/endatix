    "EmailTemplates": {
      "EmailVerification": {
        "TemplateId": "email-verification",
        "FromAddress": "noreply@endatix.com"
      },
      "UserInvitation": {
        "TemplateId": "user-invitation",
        "FromAddress": "noreply@endatix.com"
      },
      "ForgotPasswordEmail": {
        "TemplateId": "forgot-password"
      },
      "PasswordChangedEmail": {
        "TemplateId": "password-changed"
      }
    }
  }
}
