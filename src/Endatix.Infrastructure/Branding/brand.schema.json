{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.endatix.com/schemas/brand/1/brand.schema.json",
  "title": "Endatix brand pack v1 (spec artifact; H1's zod schema must generate an equal document)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "legalName": { "type": "string", "maxLength": 120 },
    "assets": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "logo": { "$ref": "#/$defs/themedFile" },
        "icon": { "$ref": "#/$defs/packFile" },
        "ogImage": { "$ref": "#/$defs/packFile" }
      }
    },
    "tokens": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "color": {
          "type": "object", "additionalProperties": false, "required": ["primary"],
          "properties": {
            "primary": { "$ref": "#/$defs/colorToken" },
            "primary-on-dark": { "$ref": "#/$defs/colorToken" }
          }
        }
      }
    },
    "links": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "website": { "$ref": "#/$defs/url" }, "docs": { "$ref": "#/$defs/url" },
        "support": { "$ref": "#/$defs/url" }, "privacy": { "$ref": "#/$defs/url" },
        "terms": { "$ref": "#/$defs/url" }
      }
    },
    "poweredBy": { "type": "boolean" },
    "personas": {
      "type": "object", "additionalProperties": false,
      "properties": { "assistant": { "type": "string", "minLength": 1 }, "bot": { "type": "string", "minLength": 1 } }
    },
    "email": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "senderName": { "type": "string", "minLength": 1 },
        "fromAddress": { "type": "string", "format": "email" },
        "supportAddress": { "type": "string", "format": "email" }
      }
    }
  },
  "$defs": {
    "packFile": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:)[A-Za-z0-9._/-]+$" },
    "themedFile": {
      "type": "object", "additionalProperties": false, "required": ["light"],
      "properties": { "light": { "$ref": "#/$defs/packFile" }, "dark": { "$ref": "#/$defs/packFile" } }
    },
    "colorToken": {
      "type": "object", "additionalProperties": false, "required": ["$type", "$value"],
      "properties": { "$type": { "const": "color" }, "$value": { "type": "string", "minLength": 4 } }
    },
    "url": { "type": "string", "format": "uri", "pattern": "^(https?:|mailto:)" }
  }
}
