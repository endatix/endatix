{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.endatix.com/schemas/brand/1/brand.schema.json",
  "title": "Endatix brand pack v1 (spec artifact; H1's zod schema must generate an equal document)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "legalName": {
      "type": "string",
      "maxLength": 120
    },
    "assets": {
      "type": "object",
      "properties": {
        "logo": {
          "$ref": "#/$defs/themedFile"
        },
        "icon": {
          "$ref": "#/$defs/packFile"
        },
        "ogImage": {
          "$ref": "#/$defs/packFile"
        }
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "color": {
          "type": "object",
          "properties": {
            "primary": {
              "$ref": "#/$defs/colorToken"
            },
            "primary-on-dark": {
              "$ref": "#/$defs/colorToken"
            }
          },
          "required": [
            "primary"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "properties": {
        "website": {
          "$ref": "#/$defs/url"
        },
        "docs": {
          "$ref": "#/$defs/url"
        },
        "support": {
          "$ref": "#/$defs/url"
        },
        "privacy": {
          "$ref": "#/$defs/url"
        },
        "terms": {
          "$ref": "#/$defs/url"
        }
      },
      "additionalProperties": false
    },
    "poweredBy": {
      "type": "boolean"
    },
    "personas": {
      "type": "object",
      "properties": {
        "assistant": {
          "type": "string",
          "minLength": 1
        },
        "bot": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "email": {
      "type": "object",
      "properties": {
        "senderName": {
          "type": "string",
          "minLength": 1
        },
        "fromAddress": {
          "type": "string",
          "format": "email"
        },
        "supportAddress": {
          "type": "string",
          "format": "email"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "name"
  ],
  "additionalProperties": false,
  "$defs": {
    "themedFile": {
      "type": "object",
      "properties": {
        "light": {
          "$ref": "#/$defs/packFile"
        },
        "dark": {
          "$ref": "#/$defs/packFile"
        }
      },
      "required": [
        "light"
      ],
      "additionalProperties": false
    },
    "packFile": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
    },
    "colorToken": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "color"
        },
        "$value": {
          "type": "string",
          "minLength": 4
        }
      },
      "required": [
        "$type",
        "$value"
      ],
      "additionalProperties": false
    },
    "url": {
      "type": "string",
      "pattern": "^(https?:|mailto:)",
      "format": "uri"
    }
  }
}
