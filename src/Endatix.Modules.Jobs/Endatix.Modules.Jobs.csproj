<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Endatix.Modules.Jobs</PackageId>
    <Title>Endatix - Background Jobs Module</Title>
    <Description>
      This package contains the Background Jobs module of the Endatix Platform. The BackgroundJobs table is the record of every job, and Quartz.NET, clustered in the same database, schedules and fires them. Persistence lives in its own "jobs" schema with its own migration history, so job migrations deploy independently of app-schema migrations. Quartz.NET is Apache-2.0 licensed; see THIRD-PARTY-NOTICES in this package.

      $(EndatixPlatformDescription)
    </Description>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>Endatix.Modules.Jobs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Quartz" />
    <!-- GHSA-w3x6-4m5h-cxqf: pins transitive 9.0.0 from EF Design; design-time only (PrivateAssets). -->
    <PackageReference Include="System.Security.Cryptography.Xml">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Endatix.Core\Endatix.Core.csproj" />
    <ProjectReference Include="..\Endatix.Framework\Endatix.Framework.csproj" />
    <ProjectReference Include="..\Endatix.Infrastructure\Endatix.Infrastructure.csproj" />
    <ProjectReference Include="..\Endatix.Api\Endatix.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Quartz.NET's Apache-2.0 licence and NOTICE travel with every package that depends on it. -->
    <None Include="..\..\THIRD-PARTY-NOTICES" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Endatix.Modules.Jobs.Tests" />
    <InternalsVisibleTo Include="Endatix.IntegrationTests" />
    <!-- Lets NSubstitute proxy this module's internal interfaces, whose proxy assembly is unsigned, so no key. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
