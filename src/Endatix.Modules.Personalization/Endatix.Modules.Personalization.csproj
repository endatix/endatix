<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Endatix.Modules.Personalization</PackageId>
    <Title>Endatix - Personalization Module</Title>
    <Description>
      Audience personalization for Endatix: per-form properties and people, tenant match key,
      and (later) personalised links. Own schema and migrations. Disabled until
      Endatix:FeatureFlags:PersonalizationModule is enabled.

      $(EndatixPlatformDescription)
    </Description>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>Endatix.Modules.Personalization</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="Ardalis.GuardClauses" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="System.Security.Cryptography.Xml">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Endatix.Core\Endatix.Core.csproj" />
    <ProjectReference Include="..\Endatix.Framework\Endatix.Framework.csproj" />
    <ProjectReference Include="..\Endatix.Infrastructure\Endatix.Infrastructure.csproj" />
    <ProjectReference Include="..\Endatix.Api\Endatix.Api.csproj" />
    <ProjectReference Include="..\Endatix.Modules.Personalization.Contracts\Endatix.Modules.Personalization.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Endatix.Modules.Personalization.Tests" />
    <InternalsVisibleTo Include="Endatix.IntegrationTests" />
  </ItemGroup>
</Project>
