<?xml version="1.0" encoding="utf-8"?>
<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- xunit v3 test projects are self-hosted Microsoft.Testing.Platform executables; `dotnet test`
             uses MTP via global.json, and running the exe directly takes the same MTP options. -->
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Test methods carry no XML docs. Without a doc file the compiler skips CS1591, which
             .editorconfig only lowers to a suggestion: SonarCloud still imports it from the SARIF log. -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Do not inherit oss RuntimeFrameworkVersion (10.0.6); use the SDK default so tests run on locally installed 10.0.x. -->
        <RuntimeFrameworkVersion />
        <RollForward>LatestMinor</RollForward>
        <!-- Sonar imports xUnit1051 from the build. Pass TestContext.Current.CancellationToken (or
             Arg.Any<CancellationToken>() in an NSubstitute call) so no test adds one. -->
        <WarningsAsErrors>$(WarningsAsErrors);xUnit1051</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <!-- One coverage config for every test project (coverlet.MTP reads it next to the test exe). -->
        <None Include="$(MSBuildThisFileDirectory)testconfig.json" Link="testconfig.json" CopyToOutputDirectory="PreserveNewest" />
        <!-- One xunit config for every test app without its own: runs under the invariant culture, so a test's
             outcome does not depend on the machine's language. xunit reads culture from xunit.runner.json only,
             not from testconfig.json. The integration project keeps its own file. -->
        <None Include="$(MSBuildThisFileDirectory)xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"
              Condition="'$(OutputType)' == 'Exe' And !Exists('$(MSBuildProjectDirectory)/xunit.runner.json')" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="FluentAssertions" />
        <Using Include="NSubstitute" />
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.MTP" />
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="xunit.v3.mtp-v2" />
    </ItemGroup>
</Project>