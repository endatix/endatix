            },
            {
              "type": "radiogroup",
              "name": "cfqSelectedOk",
              "title": "Is {panel.itemText} open late?",
              "choices": [
                {
                  "value": "1",
                  "text": "Yes"
                },
                {
                  "value": "2",
                  "text": "No"
