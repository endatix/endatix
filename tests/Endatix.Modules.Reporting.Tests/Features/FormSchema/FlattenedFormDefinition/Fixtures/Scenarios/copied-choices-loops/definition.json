    },
    {
      "name": "profile",
      "elements": [
        {
          "type": "paneldynamic",
          "name": "household",
          "title": "Household members",
          "templateElements": [
            {
              "type": "radiogroup",
              "name": "member",
              "choices": [
                {
                  "value": "1",
                  "text": "Adult"
                },
                {
                  "value": "2",
                  "text": "Child"
                }
              ]
            },
            {
              "type": "checkbox",
              "name": "pets",
              "choices": [
                {
                  "value": "1",
                  "text": "Dog"
                },
                {
                  "value": "2",
                  "text": "Cat"
                },
                {
                  "value": "3",
                  "text": "Fish"
                }
              ]
            }
          ]
        },
        {
          "type": "matrix",
          "name": "satisfaction",
          "columns": [
            {
              "value": "1",
              "text": "Low"
            },
            {
              "value": "2",
              "text": "Medium"
            },
            {
              "value": "3",
              "text": "High"
            }
          ],
          "rows": [
            {
              "value": "price",
              "text": "Price"
            },
            {
              "value": "taste",
              "text": "Taste"
            }
          ]
        },
        {
          "type": "matrixdropdown",
          "name": "usage",
          "columns": [
            {
              "name": "frequency",
              "cellType": "dropdown",
              "choices": [
                {
                  "value": "1",
                  "text": "Rarely"
                },
                {
                  "value": "2",
                  "text": "Weekly"
                },
                {
                  "value": "3",
                  "text": "Daily"
                }
              ]
            },
            {
              "name": "note",
              "cellType": "text"
            }
          ],
          "rows": [
            {
              "value": "home",
              "text": "At home"
            },
            {
              "value": "work",
              "text": "At work"
            }
          ]
        },
        {
          "type": "multipletext",
          "name": "contact",
          "items": [
            {
              "name": "city",
              "title": "City"
            },
            {
              "name": "zip",
              "title": "Postal code"
            }
          ]
        },
        {
          "type": "text",
          "name": "comments",
          "title": "Anything else?"
        }
      ]
    }
  ]
}
