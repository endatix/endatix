        {
          "type": "radiogroup",
          "name": "cfqUnselectedOne",
          "title": "Pick one store (cfq, unselected)",
          "choicesFromQuestion": "stores",
          "choicesFromQuestionMode": "unselected"
        },
        {
          "type": "ranking",
          "name": "cfqUnselectedRank",
          "title": "Rank stores (cfq, unselected)",
          "choicesFromQuestion": "stores",
          "choicesFromQuestionMode": "unselected"
        },
        {
          "type": "paneldynamic",
          "name": "cfqUnselectedLoop",
          "loopSource": [
            "cfqUnselectedOne"
          ],
          "templateElements": [
            {
              "type": "html",
              "name": "cfqUnselectedLoopIntro",
