{
  "title": "Copied choices survey (synthetic)",
  "calculatedValues": [
    {
      "name": "brandPool",
      "expression": "[1, 2, 3]",
      "includeIntoResult": true
    },
    {
      "name": "regionLabel",
      "expression": "{region}"
    }
  ],
  "pages": [
    {
      "name": "screening",
      "elements": [
        {
          "type": "html",
          "name": "welcome",
          "html": "<p>Thank you for taking part.</p>"
        },
        {
          "type": "radiogroup",
          "name": "region",
          "title": "Region",
          "visible": false,
          "defaultValue": "2",
          "choices": [
            {
              "value": "1",
              "text": "North"
            },
            {
              "value": "2",
              "text": "South"
            },
            {
              "value": "3",
              "text": "East"
            }
          ]
        },
        {
          "type": "checkbox",
          "name": "hiddenBrands",
          "title": "Brands shown to this respondent",
          "visible": false,
          "defaultValueExpression": "{brandPool}",
          "choices": [
            {
              "value": "1",
              "text": "<p><b>Brand A</b></p>"
            },
            {
              "value": "2",
              "text": "Brand B"
            },
            {
              "value": "3",
              "text": "Brand C"
            }
          ]
        },
        {
          "type": "checkbox",
          "name": "hiddenTraits",
          "title": "Traits shown to this respondent",
          "visible": false,
          "defaultValueExpression": "[1, 2, 3]",
          "choices": [
            {
              "value": "1",
              "text": "Fresh"
            },
            {
              "value": "2",
              "text": "Cheap"
            },
            {
              "value": "3",
              "text": "Local"
            }
          ]
        }
      ]
    },
    {
      "name": "awareness",
      "elements": [
        {
          "type": "checkbox",
          "name": "AidedBrands",
          "title": "Which of these brands have you heard of?",
          "choicesFromQuestion": "hiddenBrands",
          "choicesFromQuestionMode": "selected",
          "showNoneItem": true
        },
        {
          "type": "radiogroup",
          "name": "favorite",
          "title": "Which one is your favorite?",
          "choicesFromQuestion": "AidedBrands",
          "choicesFromQuestionMode": "selected"
        },
        {
          "type": "ranking",
          "name": "brandRank",
          "title": "Rank the brands you know",
          "choicesFromQuestion": "AidedBrands",
          "choicesFromQuestionMode": "selected",
          "selectToRankEnabled": true
        }
      ]
    },
    {
      "name": "loops",
      "elements": [
        {
          "type": "paneldynamic",
          "name": "considerLoop",
          "loopSource": [
            "AidedBrands"
          ],
          "templateElements": [
            {
              "type": "html",
              "name": "considerLoopIntro",
              "html": "<p>About {panel.itemText}</p>"
            },
            {
              "type": "radiogroup",
              "name": "consider",
              "title": "Would you consider {panel.itemText}?",
              "choices": [
                {
                  "value": "1",
                  "text": "Yes"
                },
                {
                  "value": "2",
                  "text": "No"
                }
              ]
            }
          ],
          "visibleIf": "{region} = '2'"
        },
        {
          "type": "paneldynamic",
          "name": "traitsLoop",
          "loopSource": [
            "AidedBrands"
          ],
          "templateElements": [
            {
              "type": "html",
              "name": "traitsLoopIntro",
              "html": "<p>About {panel.itemText}</p>"
            },
            {
              "type": "checkbox",
              "name": "traits",
              "title": "What describes {panel.itemText}?",
              "choicesFromQuestion": "hiddenTraits",
              "choicesFromQuestionMode": "selected",
              "showNoneItem": true,
              "showOtherItem": true
            }
          ]
        },
        {
          "type": "paneldynamic",
          "name": "attributeLoop",
          "loopSource": [
            "hiddenBrands"
          ],
          "templateElements": [
            {
              "type": "html",
              "name": "attributeLoopIntro",
              "html": "<p>About {panel.itemText}</p>"
            },
            {
              "type": "checkbox",
              "name": "attribute",
              "title": "Which brands share this with {panel.itemText}?",
              "choicesFromQuestion": "AidedBrands",
              "choicesFromQuestionMode": "selected",
              "showNoneItem": true,
              "choices": [
                "item1",
                "item2",
                "item3"
              ]
            }
          ]
        },
        {
          "type": "paneldynamic",
          "name": "rankLoop",
          "loopSource": [
            "brandRank"
          ],
          "templateElements": [
            {
              "type": "html",
              "name": "rankLoopIntro",
              "html": "<p>About {panel.itemText}</p>"
            },
            {
              "type": "radiogroup",
              "name": "rankPick",
              "title": "Which brand comes closest to {panel.itemText}?",
              "choicesFromQuestion": "AidedBrands",
              "choicesFromQuestionMode": "selected"
            }
          ]
        },
        {
          "type": "paneldynamic",
          "name": "reasonLoop",
          "loopSource": [
            "AidedBrands"
          ],
          "templateElements": [
            {
              "type": "html",
              "name": "reasonLoopIntro",
              "html": "<p>About {panel.itemText}</p>"
            },
            {
              "type": "text",
              "name": "reason",
              "title": "Why {panel.itemText}?"
            }
          ],
          "randomizeLoop": true
        }
      ]
    },
    {
      "name": "copies",
      "elements": [
        {
          "type": "checkbox",
          "name": "stores",
          "title": "Where do you shop?",
          "choices": [
            {
              "value": "1",
              "text": "Store A"
            },
            {
              "value": "2",
              "text": "Store B"
            },
            {
              "value": "3",
              "text": "Store C"
            }
          ]
        },
        {
          "type": "checkbox",
          "name": "cfqAllPick",
          "title": "Pick stores (cfq, all)",
          "choicesFromQuestion": "stores",
          "choicesFromQuestionMode": "all"
        },
        {
          "type": "radiogroup",
          "name": "cfqAllOne",
          "title": "Pick one store (cfq, all)",
          "choicesFromQuestion": "stores",
          "choicesFromQuestionMode": "all"
        },
        {
          "type": "ranking",
          "name": "cfqAllRank",
          "title": "Rank stores (cfq, all)",
          "choicesFromQuestion": "stores",
          "choicesFromQuestionMode": "all"
        },
        {
          "type": "paneldynamic",
          "name": "cfqAllLoop",
          "loopSource": [
            "cfqAllPick"
          ],
          "templateElements": [
            {
              "type": "html",
              "name": "cfqAllLoopIntro",
              "html": "<p>About {panel.itemText}</p>"
            },
            {
              "type": "radiogroup",
              "name": "cfqAllOk",
              "title": "Is {panel.itemText} open late?",
              "choices": [
                {
                  "value": "1",
