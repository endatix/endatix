<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Endatix.IntegrationTests</RootNamespace>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Endatix.Infrastructure.Tests\Features\ReCaptcha\Fixtures\Siteverify\*.json">
      <Link>Features\ReCaptcha\Fixtures\Siteverify\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Endatix.Modules.Reporting.Tests\Features\FormSchema\FlattenedFormDefinition\Fixtures\AllQuestions\**\*">
      <Link>Fixtures\AllQuestions\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Endatix.Modules.Reporting.Tests\Features\FormSchema\FlattenedFormDefinition\Fixtures\special-choices-*.json">
      <Link>Fixtures\SpecialChoices\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Endatix.Modules.Reporting.Tests\Features\FormSchema\FlattenedFormDefinition\Fixtures\AllQuestionsPersonalized\**\*">
      <Link>Fixtures\AllQuestionsPersonalized\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Endatix.IntegrationTests.Shared\Endatix.IntegrationTests.Shared.csproj" />
    <ProjectReference Include="..\..\src\Endatix.WebHost\Endatix.WebHost.csproj">
      <Aliases>EndatixWebHost</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Endatix.Infrastructure\Endatix.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Endatix.Persistence.PostgreSql\Endatix.Persistence.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Endatix.Persistence.SqlServer\Endatix.Persistence.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Endatix.Modules.Reporting\Endatix.Modules.Reporting.csproj" />
    <ProjectReference Include="..\..\src\Endatix.Modules.Jobs\Endatix.Modules.Jobs.csproj" />
  </ItemGroup>

</Project>
