<?xml version="1.0" encoding="utf-8"?>
<Project>
    <PropertyGroup>
        <!-- Local-dev placeholder, never bumped by hand. The release pipeline stamps
             -p:Version from the tag (scripts/release-prepare.sh). Other CI builds do not.
             InformationalVersion is deliberately NOT set — it defaults to the effective
             Version (+ source commit SHA via SourceLink). -->
        <Version>0.0.0-local</Version>
    </PropertyGroup>

    <!-- Only Endatix.Api is read by GET /api/system/version. A git checkout that is not a
         release reports its branch; a release line (main, hotfix/*, or a detached tag checkout)
         sitting exactly on a clean v* tag reports that tag. A dirty tree is not that release.
         No git (the Dockerfile, a CI build that does not pass -p:Version): version stays null
         and there is no branch. SourceLink appends the commit when it has one. -->
    <Target Name="ResolveLocalVersion" BeforeTargets="GetAssemblyVersion"
            Condition="'$(Version)' == '0.0.0-local' And '$(MSBuildProjectName)' == 'Endatix.Api'">
        <!-- Exec uses cmd.exe on Windows. /dev/null is not a path there, so the redirect fails and IgnoreExitCode hides it. -->
        <PropertyGroup>
            <_NullDevice Condition="$([MSBuild]::IsOSPlatform('Windows'))">nul</_NullDevice>
            <_NullDevice Condition="'$(_NullDevice)' == ''">/dev/null</_NullDevice>
        </PropertyGroup>
        <Exec Command="git symbolic-ref --short -q HEAD 2&gt;$(_NullDevice)"
              WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true"
              IgnoreStandardErrorWarningFormat="true"
              StandardOutputImportance="low" StandardErrorImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="_LocalGitBranch" />
            <Output TaskParameter="ExitCode" PropertyName="_LocalGitBranchExitCode" />
        </Exec>
        <PropertyGroup>
            <_LocalGitBranch Condition="'$(_LocalGitBranchExitCode)' != '0'"></_LocalGitBranch>
            <!-- Detached GitHub Actions checkout. A tag ref is not a branch: GITHUB_REF_NAME is the tag. -->
            <_LocalGitBranch Condition="'$(_LocalGitBranch)' == '' And '$(GITHUB_REF_TYPE)' == 'branch' And '$(GITHUB_HEAD_REF)' != ''">$(GITHUB_HEAD_REF)</_LocalGitBranch>
            <_LocalGitBranch Condition="'$(_LocalGitBranch)' == '' And '$(GITHUB_REF_TYPE)' == 'branch'">$(GITHUB_REF_NAME)</_LocalGitBranch>
            <_LocalGitBranch>$(_LocalGitBranch.Trim())</_LocalGitBranch>
            <_LocalIsReleaseLine Condition="'$(_LocalGitBranch)' == '' Or $(_LocalGitBranch.Equals('main')) Or $(_LocalGitBranch.StartsWith('hotfix/'))">true</_LocalIsReleaseLine>
        </PropertyGroup>
        <Exec Condition="'$(_LocalIsReleaseLine)' == 'true'"
              Command="git describe --tags --exact-match --dirty --match &quot;v[0-9]*&quot; 2&gt;$(_NullDevice)"
              WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true"
              IgnoreStandardErrorWarningFormat="true"
              StandardOutputImportance="low" StandardErrorImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="_LocalGitTag" />
            <Output TaskParameter="ExitCode" PropertyName="_LocalGitTagExitCode" />
        </Exec>
        <PropertyGroup Condition="'$(_LocalGitTagExitCode)' == '0' And '$(_LocalGitTag)' != '' And !$(_LocalGitTag.Contains('-dirty'))">
            <InformationalVersion>$(_LocalGitTag.Trim().TrimStart('v'))</InformationalVersion>
        </PropertyGroup>
        <ItemGroup Condition="'$(InformationalVersion)' == '' And '$(_LocalGitBranch)' != ''">
            <AssemblyMetadata Include="GitBranch" Value="$(_LocalGitBranch)" />
        </ItemGroup>
    </Target>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- GHSA-w3x6-4m5h-cxqf: patched System.Security.Cryptography.Xml in shared framework 10.0.6+. -->
        <RuntimeFrameworkVersion>10.0.6</RuntimeFrameworkVersion>
        <LangVersion>14</LangVersion>
        <NeutralLanguage>en-US</NeutralLanguage>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    </PropertyGroup>

    <PropertyGroup>
        <NSubstitutePublicKey></NSubstitutePublicKey>
    </PropertyGroup>

    <PropertyGroup>
        <Company>Endatix, Ltd.</Company>
        <Authors>Endatix team and Community contributors</Authors>
        <Owners>Endatix team and Community contributors</Owners>
        <Copyright>Copyright © Endatix, Ltd. $([System.DateTime]::Today.ToString('yyyy'))</Copyright>
        <Product>Endatix Platform</Product>
        <PackageProjectUrl>https://endatix.com</PackageProjectUrl>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/endatix/endatix</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>endatix,forms,open-source,data collection,data processing,data insights</PackageTags>
        <EndatixPlatformDescription>Endatix Platform is an open-source data collection and management library for .NET.</EndatixPlatformDescription>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)/build/endatix-icon.png">
            <Pack>True</Pack>
            <PackagePath>icon.png</PackagePath>
        </None>
        <None Include="README.md">
            <Pack>True</Pack>
            <PackagePath>README.md</PackagePath>
        </None>
    </ItemGroup>

    <PropertyGroup>
        <!-- https://devblogs.microsoft.com/visualstudio/vs-toolbox-accelerate-your-builds-of-sdk-style-net-projects/ -->
        <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    </PropertyGroup>
</Project>