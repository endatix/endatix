{
  "ConnectionStrings": {
    "DefaultConnection": "{YOUR_DATABASE_CONNECTION_STRING}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "System": "Information"
    },
    "Console": {
      "FormatterName": "simple"
    }
  },
  "Endatix": {
    "Auth": {
      "Providers": {
        "EndatixJwt": {
          "SigningKey": "{YOUR_JWT_SIGNING_KEY_HERE}",
          "AccessExpiryInMinutes": 1440,
          "Issuer": "endatix-api",
          "Audiences": [
            "endatix-hub",
            "endatix-client"
          ]
        }
      }
    },
    "EmailVerification": {
      "TokenExpiryInHours": 24
    }
  }
}
